<Project Sdk="Microsoft.NET.Sdk">
  <!-- Drives the compiled plugin (loaded by path, so the same runner can test the
       shipped 1.0.2 build and the working tree) against a fake Ludo API that
       enforces the real public contract, or against the live API. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LudoHarness</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UnityStubs/UnityStubs.csproj" />
  </ItemGroup>
</Project>
